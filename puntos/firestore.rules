rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Roles otorgados únicamente desde la consola de Firebase.
    function signedIn() {
      return request.auth != null;
    }
    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function servicePoints(serviceId) {
      return serviceId == 'manicura' ? 30
        : serviceId == 'pedicura' ? 40
        : serviceId == 'pestanas' ? 50
        : serviceId == 'mechas' ? 90
        : serviceId == 'alisado' ? 110 : -1;
    }
    function serviceName(serviceId) {
      return serviceId == 'manicura' ? 'Manicura'
        : serviceId == 'pedicura' ? 'Pedicura'
        : serviceId == 'pestanas' ? 'Pestañas'
        : serviceId == 'mechas' ? 'Mechas'
        : serviceId == 'alisado' ? 'Alisado' : '';
    }
    function rewardPoints(rewardId) {
      return rewardId == 'manicura' ? 200
        : rewardId == 'pedicura' ? 400
        : rewardId == 'lifting' ? 650
        : rewardId == 'alisado' ? 1000 : -1;
    }
    function visitPath(id) {
      return /databases/$(database)/documents/visits/$(id);
    }
    function redeemPath(id) {
      return /databases/$(database)/documents/redemptions/$(id);
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function voidPath(id) {
      return /databases/$(database)/documents/voids/$(id);
    }
    // Toda acreditación debe venir acompañada de UNA nueva visita inmutable
    // en la misma transacción. Los puntos son fijos por tipo de servicio.
    function validVisitBalance(uid) {
      let vid = request.resource.data.lastEventId;
      let v = getAfter(visitPath(vid)).data;
      return !exists(visitPath(vid))
        && v.userId == uid
        && v.staffId == request.auth.uid
        && v.points == servicePoints(v.serviceId)
        && v.createdAt == request.time
        && request.resource.data.points == resource.data.points + v.points
        && request.resource.data.visits == resource.data.visits + 1;
    }
    // Los descuentos solo ocurren al aprobar un canje previamente pendiente,
    // también dentro de la misma transacción.
    function validRedeemBalance(uid) {
      let rid = request.resource.data.lastEventId;
      let previous = get(redeemPath(rid)).data;
      let next = getAfter(redeemPath(rid)).data;
      return previous.status == 'pending'
        && next.status == 'approved'
        && previous.userId == uid
        && next.userId == uid
        && next.processedBy == request.auth.uid
        && next.processedAt == request.time
        && rewardPoints(next.rewardId) > 0
        && request.resource.data.points == resource.data.points - rewardPoints(next.rewardId)
        && request.resource.data.visits == resource.data.visits;
    }
    // Anular una atención exige crear un comprobante único y ajustar saldo y
    // visitas en una sola transacción. La visita original nunca se elimina.
    function validVoidBalance(uid) {
      let voidId = request.resource.data.lastEventId;
      let cancellation = getAfter(voidPath(voidId)).data;
      let visit = get(visitPath(cancellation.visitId)).data;
      return !exists(voidPath(voidId))
        && voidId == 'void-' + cancellation.visitId
        && cancellation.userId == uid
        && cancellation.staffId == request.auth.uid
        && visit.userId == uid
        && cancellation.points == visit.points
        && cancellation.points == servicePoints(visit.serviceId)
        && cancellation.createdAt == request.time
        && resource.data.points >= cancellation.points
        && resource.data.visits >= 1
        && request.resource.data.points == resource.data.points - cancellation.points
        && request.resource.data.visits == resource.data.visits - 1;
    }
    match /admins/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if owns(uid)
        && request.resource.data.keys().hasAll(['displayName','email','photoURL','points','visits','createdAt','updatedAt','lastEventId','lastEventType'])
        && request.resource.data.keys().hasOnly(['displayName','email','photoURL','points','visits','createdAt','updatedAt','lastEventId','lastEventType'])
        && request.resource.data.displayName is string
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.photoURL is string
        && request.resource.data.points == 0
        && request.resource.data.visits == 0
        && request.resource.data.lastEventId == ''
        && request.resource.data.lastEventType == 'none'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['points','visits','updatedAt','lastEventId','lastEventType'])
        && request.resource.data.points is int
        && request.resource.data.visits is int
        && request.resource.data.points >= 0
        && request.resource.data.visits >= 0
        && request.resource.data.lastEventId is string
        && request.resource.data.lastEventId.size() > 0
        && request.resource.data.lastEventId.size() < 128
        && request.resource.data.lastEventId != resource.data.lastEventId
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.lastEventType == 'visit' && validVisitBalance(uid))
          || (request.resource.data.lastEventType == 'redemption' && validRedeemBalance(uid))
          || (request.resource.data.lastEventType == 'void' && validVoidBalance(uid)));
      allow delete: if false;
    }
    match /visits/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['userId','serviceId','serviceName','points','createdAt','staffId'])
        && request.resource.data.keys().hasOnly(['userId','serviceId','serviceName','points','createdAt','staffId'])
        && request.resource.data.staffId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.userId is string
        && request.resource.data.points == servicePoints(request.resource.data.serviceId)
        && request.resource.data.points > 0
        && request.resource.data.serviceName == serviceName(request.resource.data.serviceId)
        && exists(userPath(request.resource.data.userId))
        && getAfter(userPath(request.resource.data.userId)).data.lastEventId == id
        && getAfter(userPath(request.resource.data.userId)).data.lastEventType == 'visit';
      allow update, delete: if false;
    }
    match /voids/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['visitId','userId','points','reason','staffId','createdAt'])
        && request.resource.data.keys().hasOnly(['visitId','userId','points','reason','staffId','createdAt'])
        && request.resource.data.visitId is string
        && request.resource.data.visitId.size() > 0
        && request.resource.data.visitId.size() < 100
        && id == 'void-' + request.resource.data.visitId
        && request.resource.data.userId is string
        && request.resource.data.staffId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 200
        && request.resource.data.points is int
        && request.resource.data.points > 0
        && exists(visitPath(request.resource.data.visitId))
        && get(visitPath(request.resource.data.visitId)).data.userId == request.resource.data.userId
        && get(visitPath(request.resource.data.visitId)).data.points == request.resource.data.points
        && getAfter(userPath(request.resource.data.userId)).data.lastEventId == id
        && getAfter(userPath(request.resource.data.userId)).data.lastEventType == 'void';
      allow update, delete: if false;
    }
    // Reservas: solo la jefa crea y cambia la agenda; la clienta solo solicita reagendar.
    function validReservation() {
      let d = request.resource.data;
      return d.keys().hasAll(['userId','clientName','staffId','service','date','start','end','notes','status','rescheduleRequested','createdAt','updatedAt'])
        && d.keys().hasOnly(['userId','clientName','staffId','service','date','start','end','notes','status','rescheduleRequested','createdAt','updatedAt','requestedAt'])
        && d.userId is string && exists(userPath(d.userId))
        && d.clientName is string && d.clientName.size() <= 200
        && d.staffId in ['m1','m2']
        && d.service in ['Manicura clásica','Soft Gel','Pedicura','Pestañas','Mechas','Alisado','Otro']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}
      allow get, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId','rewardId','status','createdAt'])
        && request.resource.data.keys().hasOnly(['userId','rewardId','status','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && rewardPoints(request.resource.data.rewardId) > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && get(userPath(request.auth.uid)).data.points >= rewardPoints(request.resource.data.rewardId);
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','processedBy','processedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAll(['status','processedBy','processedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time
        && (request.resource.data.status == 'rejected'
          || (
            get(userPath(resource.data.userId)).data.points >= rewardPoints(resource.data.rewardId)
            && get(userPath(resource.data.userId)).data.lastEventId != id
            && getAfter(userPath(resource.data.userId)).data.lastEventId == id
            && getAfter(userPath(resource.data.userId)).data.lastEventType == 'redemption'
          ));
      allow delete: if false;
    }
  }
})
        && d.start is int && d.end is int && d.start >= 0 && d.end <= 1440
        && d.end - d.start >= 15 && d.end - d.start <= 720
        && d.notes is string && d.notes.size() <= 500
        && d.status in ['confirmed','cancelled']
        && d.rescheduleRequested is bool && d.updatedAt == request.time;
    }
    match /reservations/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin() && validReservation()
        && request.resource.data.status == 'confirmed'
        && request.resource.data.rescheduleRequested == false
        && request.resource.data.createdAt == request.time;
      allow update: if (isAdmin() && validReservation()
        && resource.data.status == 'confirmed'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rescheduleRequested == false)
        || (owns(resource.data.userId)
          && resource.data.status == 'confirmed'
          && resource.data.rescheduleRequested == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rescheduleRequested','requestedAt'])
          && request.resource.data.rescheduleRequested == true
          && request.resource.data.requestedAt == request.time);
      allow delete: if false;
    }
    match /reservationDays/{day} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['slots'])
        && request.resource.data.slots is list
        && request.resource.data.slots.size() <= 120;
      allow delete: if false;
    }
    match /redemptions/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['userId','rewardId','status','createdAt'])
        && request.resource.data.keys().hasOnly(['userId','rewardId','status','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && rewardPoints(request.resource.data.rewardId) > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && get(userPath(request.auth.uid)).data.points >= rewardPoints(request.resource.data.rewardId);
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','processedBy','processedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasAll(['status','processedBy','processedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.processedBy == request.auth.uid
        && request.resource.data.processedAt == request.time
        && (request.resource.data.status == 'rejected'
          || (
            get(userPath(resource.data.userId)).data.points >= rewardPoints(resource.data.rewardId)
            && get(userPath(resource.data.userId)).data.lastEventId != id
            && getAfter(userPath(resource.data.userId)).data.lastEventId == id
            && getAfter(userPath(resource.data.userId)).data.lastEventType == 'redemption'
          ));
      allow delete: if false;
    }
  }
}